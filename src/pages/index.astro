---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
const posts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Marten Mrfc",
    url: "https://marten-mrfc.is-a.dev",
    sameAs: ["https://github.com/Marten-Mrfc"],
    jobTitle: "Developer",
    knowsAbout: [
        "Kotlin",
        "Minecraft plugin development",
        "Technical documentation",
    ],
});
---

<BaseLayout
    title="Marten - Developer"
    description="I build loads of things. From Full-stack web applications to simple Minecraft plugins"
>
    <script
        is:inline
        type="application/ld+json"
        set:html={jsonLd}
        slot="head"
    />

    <section class="hero" aria-labelledby="intro-heading">
        <h1 id="intro-heading" class="rotator">
            <span class="sr-only">I look at code.</span>
            <span class="rotator-mask" aria-hidden="true">
                <span class="rotator-list">
                    <span>I look at code.</span>
                    <span>I write Kotlin code.</span>
                    <span>I love cows.</span>
                    <span>I write TypeScript code.</span>
                    <span>I write documentation.</span>
                    <span>I look at documentation.</span>
                    <span aria-hidden="true">I look at code.</span>
                </span>
            </span>
        </h1>
        <p>
            Hey, I'm Marten. My main job is being a Full-stack developer and in my free time I work on projects like <a href="/projects/typewriter/">TypeWriter</a> and that work lives on <a href="https://github.com/Marten-Mrfc">GitHub</a>.
        </p>
        <p>
            Still a simple school Student who is based in the <span style="color:red;">Net</span><span style="color: white;">her</span><span style="color: blue;">lands</span>.
        </p>
    </section>

    <section aria-labelledby="projects-heading">
        <h2 id="projects-heading">Projects</h2>
        <ul class="rows">
            {
                projects.map((project) => (
                    <li class="row">
                        <div>
                            <h3>
                                <a
                                    href={`/projects/${project.id}/`}
                                    style={`view-transition-name: project-${project.id}`}
                                >
                                    {project.data.title}
                                </a>
                            </h3>
                            <p>{project.data.description}</p>
                        </div>
                        <span class="meta">
                            {project.data.startDate.getFullYear()}–
                            {project.data.endDate?.getFullYear() ?? "now"}
                        </span>
                    </li>
                ))
            }
        </ul>
    </section>

    <section aria-labelledby="writing-heading">
        <h2 id="writing-heading">Writing</h2>
        <ul class="rows">
            {
                posts.map((post) => (
                    <li class="row">
                        <div>
                            <h3>
                                <a
                                    href={`/blog/${post.id}/`}
                                    style={`view-transition-name: post-${post.id}`}
                                >
                                    {post.data.title}
                                </a>
                            </h3>
                            <p>{post.data.description}</p>
                        </div>
                        <span class="meta">
                            <time
                                datetime={post.data.pubDate
                                    .toISOString()
                                    .slice(0, 10)}
                            >
                                {post.data.pubDate.toISOString().slice(0, 10)}
                            </time>
                        </span>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>

<style>
    /* Rotating headline — a vertical "roll": phrases are stacked in a column
       and a one-line mask clips it, so the list scrolls up one phrase at a
       time, holding on each long enough to read. The first phrase is repeated
       at the end so the wrap-around from last → first is seamless.
       Pure CSS; the accessible name lives in the sr-only heading above, so
       screen readers hear one phrase and the cycle stays decorative. */
    .rotator-mask {
        display: inline-block;
        height: 1lh;
        overflow: hidden;
        vertical-align: top;
    }

    .rotator-list {
        display: flex;
        flex-direction: column;
    }

    .rotator-list > span {
        height: 1lh;
        white-space: nowrap;
    }

    @media (prefers-reduced-motion: no-preference) {
        .rotator-list {
            /* One eased slide per phrase, most of each slot spent holding. */
            animation: rotate-phrase 18s infinite;
            animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
        }
    }

    /* Each phrase holds, then rolls up to the next. The final stop (-6lh) is
       the duplicated first phrase, visually identical to 0 → no jump on loop. */
    @keyframes rotate-phrase {
        0%,
        14% {
            translate: 0 0;
        }
        16.67%,
        30.6% {
            translate: 0 -1lh;
        }
        33.33%,
        47.3% {
            translate: 0 -2lh;
        }
        50%,
        64% {
            translate: 0 -3lh;
        }
        66.67%,
        80.6% {
            translate: 0 -4lh;
        }
        83.33%,
        97.3% {
            translate: 0 -5lh;
        }
        100% {
            translate: 0 -6lh;
        }
    }
</style>
