---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
	title="Marten - Blog"
	description="Write-ups on Minecraft plugin development, Kotlin, and building for the web."
>
	<header class="article-header">
		<h1>Blog</h1>
		<p class="meta">occasional write-ups &middot; <a href="/rss.xml">rss</a></p>
	</header>

	<ul class="rows">
		{
			posts.map((post) => (
				<li class="row">
					<div>
						<h3>
							<a href={`/blog/${post.id}/`} style={`view-transition-name: post-${post.id}`}
								>{post.data.title}</a
							>
						</h3>
						<p>{post.data.description}</p>
					</div>
					<span class="meta">
						<time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
							{post.data.pubDate.toISOString().slice(0, 10)}
						</time>
					</span>
				</li>
			))
		}
	</ul>
</BaseLayout>
